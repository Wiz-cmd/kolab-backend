# Copy to .env.production and fill real / secret values.
NODE_ENV=production
PORT=3000
APP_BASE_URL="https://api.kolab.co.za"
CORS_ORIGINS="https://app.kolab.co.za"
DATABASE_URL="postgresql://USER:PASSWORD@DB_HOST:5432/kolab?schema=public"
JWT_ACCESS_EXPIRES_IN="1h"
JWT_SECRET="<generate with: openssl rand -hex 64>"
# Rate limiting (per IP per window)
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
# Stricter per-IP limits on login/register to blunt brute force & lockout abuse.
AUTH_RATE_LIMIT_MAX=20
AUTH_RATE_LIMIT_WINDOW_MS=60000
# Reverse-proxy hops (1 when behind nginx/traefik/ALB) for real client IPs.
TRUST_PROXY=0

# Object storage (use R2 or S3)
S3_BUCKET="kolab-production"
S3_REGION="auto"
S3_ENDPOINT=""                 # R2 endpoint
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_CDN_BASE_URL="https://cdn.kolab.co.za"

# Email
MAIL_DRIVER="smtp"
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="Kolab <no-reply@kolab.co.za>"
MAIL_DEV_RETURN_TOKENS="false"

# Payments (LIVE urls)
PAYFAST_MERCHANT_ID=""
PAYFAST_MERCHANT_KEY=""
PAYFAST_PASSPHRASE=""
PAYFAST_BASE_URL="https://www.payfast.co.za/eng/process"

# Ozow (LIVE)
OZOW_MERCHANT_CODE=""
OZOW_SITE_CODE=""
OZOW_PRIVATE_KEY=""
OZOW_TEST="false"
OZOW_API_URL="https://pay.ozow.com"

PLATFORM_FEE_PERCENT=20
WITHDRAWAL_FEE=10
APP_NAME="Kolab"

# Payout driver on withdrawal approval: mock | ozow | payfast
PAYOUT_DRIVER="ozow"

# Push
FIREBASE_SERVICE_ACCOUNT=""
GOOGLE_APPLICATION_CREDENTIALS=""

# Image processing
IMAGE_PROCESSING="true"
IMAGE_MAX_WIDTH=2048
IMAGE_MAX_HEIGHT=2048
IMAGE_QUALITY=82
IMAGE_OUTPUT_FORMAT="webp"

# Background jobs
JOBS_LIVE="true"

# Swagger off in prod by default
SWAGGER_ENABLED="false"

# Social login (Instagram / Twitter-X). Blank = provider disabled.
SOCIAL_REDIRECT_URL="kolab://auth/callback"
INSTAGRAM_CLIENT_ID=""
INSTAGRAM_CLIENT_SECRET=""
X_CLIENT_ID=""
X_CLIENT_SECRET=""

# Security hardening
# HSTS only with real TLS in front of the app. Should be "true" in prod.
ENABLE_HSTS="true"

# Observability
LOG_STRUCTURED="true"
SENTRY_DSN=""
SENTRY_RELEASE="kolab-backend@1.2.0"
SENTRY_TRACES_SAMPLE_RATE=0.1
# Keep false in prod: query text can embed PII.
PRISMA_LOG_QUERIES="false"
