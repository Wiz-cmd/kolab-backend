# ── App ───────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
# Base URL of this API, used to build PayFast redirect/notify + email reset links.
APP_BASE_URL="http://localhost:3000"
# Comma-separated allowed CORS origins, or "*" during development.
CORS_ORIGINS="http://localhost:3000,http://localhost:8080"

# ── Database ──────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:password@localhost:5432/kolab?schema=public"

# ── JWT ───────────────────────────────────────────────────────────
# Access/bearer token TTL (short-lived).
JWT_ACCESS_EXPIRES_IN="1h"
# Deprecated: kept for back-compat with older clients; prefer the above.
JWT_EXPIRES_IN="1h"
JWT_SECRET="change-this-to-a-long-random-secret-in-production"

# ── Rate limiting (per IP per window) ─────────────────────────────
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
# Stricter per-IP limits on login/register to blunt brute force & lockout abuse.
AUTH_RATE_LIMIT_MAX=20
AUTH_RATE_LIMIT_WINDOW_MS=60000
# Reverse-proxy hops (1 when behind nginx/traefik/ALB) for real client IPs.
TRUST_PROXY=0

# ── Object storage (S3 / Cloudflare R2) ───────────────────────────
# Leave S3_BUCKET empty to use LOCAL disk under UPLOAD_DIR during dev.
S3_BUCKET=""
S3_REGION="auto"
S3_ENDPOINT=""            # e.g. https://<account>.r2.cloudflarestorage.com for R2
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_BASE_URL=""     # e.g. https://<bucket>.<account>.r2.cloudflarestorage.com
S3_CDN_BASE_URL=""        # optional CDN domain, overrides PUBLIC_BASE_URL

# ── File uploads (local fallback) ─────────────────────────────────
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB=15

# ── Email (SMTP / SendGrid via SMTP) ─────────────────────────────
# Leave SMTP_HOST empty to log emails to console instead of sending.
MAIL_DRIVER="console"          # "console" | "smtp"
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE="false"            # "true" for 465
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="Kolab <no-reply@kolab.co.za>"
# Return reset/verify tokens in API responses during development only.
MAIL_DEV_RETURN_TOKENS="true"

# ── Payments (PayFast / Ozow) ────────────────────────────────────
PAYFAST_MERCHANT_ID=""
PAYFAST_MERCHANT_KEY=""
PAYFAST_PASSPHRASE=""
# Sandbox: https://sandbox.payfast.co.za/eng/process  |  Live: https://www.payfast.co.za/eng/process
PAYFAST_BASE_URL="https://sandbox.payfast.co.za/eng/process"

# Ozow checkout (second rail): https://pay.ozow.com handles the form POST.
# MerchantCode / SiteCode / PrivateKey come from your Ozow dashboard.
OZOW_MERCHANT_CODE=""
OZOW_SITE_CODE=""
OZOW_PRIVATE_KEY=""
OZOW_TEST="true"               # "true" = Ozow test/QA mode
# Ozow redirect base. Production: https://pay.ozow.com  |  Test: https://test.ozow.com
OZOW_API_URL="https://test.ozow.com"

# ── Platform ──────────────────────────────────────────────────────
PLATFORM_FEE_PERCENT=20
WITHDRAWAL_FEE=10
APP_NAME="Kolab"

# ── Payouts (dispatched on withdrawal approve) ────────────────────
# "mock" simulates a provider for tests/sandbox.
# "ozow" | "payfast" call the real provider REST API.
PAYOUT_DRIVER="mock"
OZOW_PAYOUT_URL=""            # optional override for Ozow payout endpoint
PAYFAST_PAYOUT_URL=""         # optional override for PayFast payout endpoint

# ── Push notifications (Firebase Cloud Messaging) ─────────────────
# Path to a Firebase service-account JSON file (or inline JSON). Leave empty to
# disable push and store in-app notifications only.
FIREBASE_SERVICE_ACCOUNT=""
# Alternative: point at standard Google app credentials file.
GOOGLE_APPLICATION_CREDENTIALS=""

# ── Image processing (sharp) ──────────────────────────────────────
# "true" to compress/resize images on upload (sharp required).
IMAGE_PROCESSING="true"
IMAGE_MAX_WIDTH=2048
IMAGE_MAX_HEIGHT=2048
IMAGE_QUALITY=82
IMAGE_OUTPUT_FORMAT="webp"     # "jpeg" | "webp"

# ── Background jobs (@nestjs/schedule) ────────────────────────────
# "true" to actually run scheduled recomputes (leaderboard, etc.).
JOBS_LIVE="false"

# ── Swagger / docs ────────────────────────────────────────────────
# Set to "false" to disable the /api/docs OpenAPI UI (e.g. production).
SWAGGER_ENABLED="true"

# ── Social login (Instagram / Twitter-X) ──────────────────────────
# OAuth2 app credentials from the provider developer consoles. Leave blank to
# disable the provider (the app then shows "Sign in with ... not configured").
#   Instagram: https://developers.facebook.com/docs/instagram-platform/instagram-api-with-instagram-login
#   X/Twitter: https://developer.x.com/en/portal (API v2 OAuth 2.0)
SOCIAL_REDIRECT_URL="kolab://auth/callback"
INSTAGRAM_CLIENT_ID=""
INSTAGRAM_CLIENT_SECRET=""
X_CLIENT_ID=""
X_CLIENT_SECRET=""

# ── Security hardening ────────────────────────────────────────────
# Send Strict-Transport-Security only when TLS is terminated in front of the
# app (nginx/traefik/ALB/CDN). Leave "false" for plain-HTTP local/dev setups.
ENABLE_HSTS="false"

# ── Observability ─────────────────────────────────────────────────
# Emit logs as JSON lines for log shipping.
LOG_STRUCTURED="true"
# Optional Sentry DSN. Leave empty to disable error reporting.
SENTRY_DSN=""
SENTRY_RELEASE=""
SENTRY_TRACES_SAMPLE_RATE=0.1
# "true" to log every Prisma query with duration (DB perf work / QA only;
# keep off in production — query text can embed PII).
PRISMA_LOG_QUERIES="false"
