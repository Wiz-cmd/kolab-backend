# Copy to .env.development for local development overrides.
NODE_ENV=development
PORT=3000
APP_BASE_URL="http://localhost:3000"
CORS_ORIGINS="*"
DATABASE_URL="postgresql://postgres:password@localhost:5432/kolab?schema=public"
JWT_ACCESS_EXPIRES_IN="1h"
JWT_SECRET="kolab-dev-secret-change-me"
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB=15
PLATFORM_FEE_PERCENT=20
APP_NAME="Kolab"

# Payout driver on withdrawal approval: mock | ozow | payfast
PAYOUT_DRIVER="mock"

# Testing convenience for payments/push/jobs in dev.
MAIL_DEV_RETURN_TOKENS="true"
OZOW_TEST="true"
OZOW_API_URL="https://test.ozow.com"
JOBS_LIVE="false"
SWAGGER_ENABLED="true"
LOG_STRUCTURED="true"
IMAGE_PROCESSING="true"
